# Build-time values used to generate the Cloudflare Worker configuration.
CLOUDFLARE_D1_DATABASE_ID=replace-with-your-d1-database-id
CLOUDFLARE_D1_DATABASE_NAME=recovery-inventory

# Runtime values: add these as encrypted Worker secrets in Cloudflare.
DATA_ENCRYPTION_KEY=generate-a-new-32-byte-base64url-key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_ORIGIN=https://recoveryinventory.com
EMAIL_FROM_ADDRESS=login@recoveryinventory.com
EMAIL_REPLY_TO=support@recoveryinventory.com
